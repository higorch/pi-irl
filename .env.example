# Copie para .env e ajuste:
#   cp .env.example .env
#
# Valores do .env sobrescrevem/completam o config.json ao abrir o app.

# --- MediaMTX / SRT (obrigatório para transmitir) ---
VPS_HOST=IP_OU_DOMINIO_DA_VPS
SRT_PORT=8890
STREAM_ID=irl

# --- BSBF bonding (opcional) ---
# Deixe vazio se não usar bonding. Porta/UUID vêm do bsbf-add-client na VPS.
BONDING_SERVER=
BONDING_PORT=
BONDING_UUID=
