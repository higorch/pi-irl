# Copie para .env e ajuste:
#   cp .env.example .env
#
# Valores do .env sobrescrevem/completam o config.json ao abrir o app.

# --- MediaMTX / SRT (obrigatório para transmitir) ---
VPS_HOST=IP_OU_DOMINIO_DA_VPS
SRT_PORT=8890
STREAM_ID=irl

# --- BSBF bonding (opcional) ---
# Deixe vazio se não usar bonding. Porta/UUID vêm do bsbf-add-client na VPS.
BONDING_SERVER=
BONDING_PORT=
BONDING_UUID=

# --- Senha do sudo do Pi (opcional) ---
# Usada pelo install.sh e pelo app para instalar/ativar o BSBF. Vazio = sudo sem senha.
# Fica em texto puro: o install.sh deixa o .env com permissão 600 (só seu usuário lê).
PI_SUDO_PASSWORD=

# --- Início automático ao ligar o Pi ---
# Segundos de espera após o app abrir no boot, antes de abrir a câmera (Pi, USB e rede terminam de subir).
AUTOSTART_DELAY=30
# Tentativas de conectar câmera/microfone USB no boot e ao reconectar após queda
# (0 = tenta sem limite) e intervalo em segundos.
DEVICE_RETRY_ATTEMPTS=10
DEVICE_RETRY_INTERVAL=10
